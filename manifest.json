{
  "manifest_version": 3,
  "name": "WhatSave",
  "description": "Exporte em massa mídias, legendas reais, respostas diretas e links do WhatsApp Web, na ordem cronológica da conversa.",
  "version": "1.4.2",
  "author": "Ruda Gabriel",
  "homepage_url": "https://github.com/RudaGabriel/WhatSave",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png",
    "256": "icons/256.png",
    "512": "icons/512.png"
  },
  "permissions": [
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsave@rudagabriel.github.io",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatSave"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inpage/vendor/wppconnect-wa-wrapped.js",
        "inpage/app.js",
        "assets/logo.svg"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}
